# Secret key from Stripe → Developers → API keys. Use sk_test_... until you are ready for real cards.
# On Vercel, set this in Project Settings → Environment Variables. The sandbox integration
# also creates S_STRIPE_SECRET_KEY, which the shop will use if STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=

# Optional. The public address of this site, with no trailing slash.
# On Vercel you can leave this empty. The shop uses the address in the browser.
# PUBLIC_URL=https://your-project.vercel.app

# Optional. Signing secret for the /api/stripe-webhook endpoint.
# The checkout flow works without it. Stripe still lists each payment in the dashboard.
# STRIPE_WEBHOOK_SECRET=
